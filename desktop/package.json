{
  "name": "anie-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Electron shell around `anie --rpc`. Runs from the repo checkout.",
  "type": "module",
  "main": "dist/src/main/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "verify": "npm run build && node test/verify.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^44.4.3",
    "typescript": "^5.9.0"
  }
}
